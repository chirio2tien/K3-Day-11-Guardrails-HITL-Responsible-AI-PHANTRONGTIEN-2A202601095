# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# --- Chọn nhà cung cấp LLM ---
# google   = Gemini (Google AI Studio)
# deepseek = DeepSeek qua LiteLLM (khuyến nghị khi Gemini bị 429)
LLM_PROVIDER=deepseek

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek/deepseek-chat

# Google Gemini — https://aistudio.google.com/apikey
# (chỉ cần khi LLM_PROVIDER=google)
GOOGLE_API_KEY=your-google-ai-studio-key-here
GOOGLE_GENAI_USE_VERTEXAI=0
# GOOGLE_MODEL=gemini-3.1-flash-lite
